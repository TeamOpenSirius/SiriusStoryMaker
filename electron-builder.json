{
  "appId": "org.teamopensirius.siriusstorymaker",
  "productName": "SiriusStoryMaker",
  "copyright": "Copyright © 2026 TeamOpenSirius",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "skills/**/*",
    "package.json",
    "LICENSE"
  ],
  "asarUnpack": [
    "dist-electron/mcp-server.mjs",
    "dist-electron/knowledge/**/*",
    "skills/**/*"
  ],
  "win": {
    "icon": "public/sirius-logo.png",
    "target": [
      {
        "target": "msi",
        "arch": ["x64"]
      }
    ],
    "artifactName": "${productName}-${version}-win-${arch}.${ext}"
  },
  "msi": {
    "oneClick": false,
    "perMachine": false
  },
  "linux": {
    "icon": "public/sirius-logo.png",
    "category": "AudioVideo",
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      }
    ],
    "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
  },
  "mac": {
    "icon": "public/sirius-logo.png",
    "category": "public.app-category.developer-tools",
    "identity": null,
    "target": [
      {
        "target": "dmg",
        "arch": ["arm64", "x64"]
      }
    ],
    "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
  }
}
